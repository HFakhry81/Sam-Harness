# Copy to .env and fill real values. Never commit .env.

# —— Model keys / hybrid routing ——
GEMINI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_API_KEY=
OPENAI_API_KEY=
CEO_MODEL=qwen2.5-coder:1.5b
# HYBRID_MODE=local|cloud|auto (optional; hybrid profile in DB also controls mode)
HYBRID_MODE=
# FORCE_LOCAL_SPECIALISTS=1 forces local Ollama even when a cloud key is set
FORCE_LOCAL_SPECIALISTS=

# —— Phase 5 near-zero cost (defaults are production-safe) ——
# SAM_ROUTING_ENABLED=0 disables difficulty routing (legacy cloud-if-key behavior)
SAM_ROUTING_ENABLED=1
# Exact prompt/response cache in SQLite (prompt_cache table)
SAM_CACHE_ENABLED=1
# Provider prompt-caching hints (OpenAI prompt_cache_key / Anthropic-style markers)
SAM_PROVIDER_PROMPT_CACHE=1
SAM_CACHE_TTL_MS=86400000
SAM_CACHE_MAX_ENTRIES=500
# When remaining daily budget / cap ≤ this ratio, force local/free (never exceed cap)
SAM_COST_NEAR_CAP_RATIO=0.15
SAM_CONTEXT_MAX_CHARS=24000
SAM_CONTEXT_TARGET_CHARS=16000
# Local Ollama / OpenAI-compatible endpoint (free)
SAM_LOCAL_BASE_URL=http://localhost:11434
SAM_LOCAL_MODEL=
# Optional free-tier OpenAI-compatible provider (0 USD when used)
SAM_FREE_BASE_URL=
SAM_FREE_API_KEY=
SAM_FREE_MODEL=
# Paid / cloud host (Ollama Cloud by default) — charged against daily cap
SAM_PAID_BASE_URL=https://ollama.com
SAM_PAID_MODEL=gemma4:cloud
# Escalate tier when confidence is below this (or verification failed)
SAM_ESCALATE_CONFIDENCE_BELOW=0.55
# SAM_PREFER_FREE_FOR_STANDARD=1 routes standard difficulty to free tier first
SAM_PREFER_FREE_FOR_STANDARD=

# —— Agency runtime ——
# AGENCY_MODE=1 (default) LangGraph agency; AGENCY_MODE=0 legacy linear swarm
AGENCY_MODE=1

# —— Delivery / Level-3 ——
# IMPLEMENT_GO=1 authorizes Level-3 code changes for this run (or use --go / go-nogo.json)
IMPLEMENT_GO=
# TARGET_REPO overrides task.ts targetRepo for Level-3
TARGET_REPO=
# RUN_LEVEL3=1 forces Level-3 after a successful audit gate
RUN_LEVEL3=

# —— Comms (approval-gated outbound) ——
# APPROVE_COMMS=1 AND UI approved=true required to send (never auto-send)
APPROVE_COMMS=
# EMAIL_PROVIDER=smtp|resend|dry-run
# Owner decision (Phase 3): default is smtp. Still dry-run when SMTP_* unset.
EMAIL_PROVIDER=smtp
EMAIL_FROM=
# SMTP (nodemailer) — required for real send when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
# Resend API (https://resend.com) — set EMAIL_PROVIDER=resend to use
RESEND_API_KEY=
RESEND_FROM=

# —— MCP ——
# Path to MCP servers JSON (default: ./mcp.json or ./.mcp.json). See mcp.example.json.
MCP_CONFIG=

# —— Code sandbox (run_node_sandbox) ——
# SAM_SANDBOX_DOCKER=1 prefers Docker when the daemon is available
SAM_SANDBOX_DOCKER=

# —— Daily Ops scheduler ——
# Tick interval for Control Plane in-process scheduler (ms, min 5000)
DAILY_OPS_TICK_MS=30000

# —— Control Plane UI ——
CONTROL_PLANE_PORT=8787
# CONTROL_PLANE_NO_BROWSER=1 skips auto-opening the browser on Windows
CONTROL_PLANE_NO_BROWSER=
# Owner token for Control Plane UI/API (optional). If unset, a token is
# generated on first UI start and stored in .controlplane-token (gitignored).
CONTROL_PLANE_TOKEN=

# —— Phase 7 — Arabic-first locale / i18n ——
# Docs: docs/PHASE7_ARABIC_INSTALL.md
# Default locale is Arabic (ar). English fallback for missing keys.
SAM_LOCALE=ar
# Optional overrides (default to SAM_LOCALE)
SAM_UI_LOCALE=
SAM_CONTENT_LOCALE=
# eastern = ٠١٢٣… (default for ar) · western = 0123…
SAM_NUMERALS=eastern
# Egyptian-friendly phrasing in agent language directives (1=on)
SAM_EGYPTIAN_FRIENDLY=1

# —— Filesystem sandbox (desktop-controller style) ——
# Default: allow normal user environment (home, Desktop/Documents/Downloads,
# accessible drives on Windows; /home /tmp /media /mnt /Volumes on Unix).
# Sensitive paths are always denied (Windows/System32, /etc, ~/.ssh, browser
# profiles, .controlplane-token, cost-ledger.json, …).
# WORKSPACE_ROOTS — when set, RESTRICTS allowlist to these roots (+ cwd + output home).
# WORKSPACE_DENY — extends the deny list (semicolon-separated).
# Or use workspace-roots.json: { "roots": [...], "deny": [...] }
WORKSPACE_ROOTS=
WORKSPACE_DENY=

# —— Agent output home ——
# Default: ~/Documents/Sam-Harness  (Windows: %USERPROFILE%\Documents\Sam-Harness)
# Subfolders: reports/ documents/ exports/ runs/<date>/<run-id>/ memory/ temp/ state/
# Non-default tenants use workspaces/<tenantId>/ under this home.
SAM_OUTPUT_HOME=

# —— Persistence (Phase 3) ——
# Default: SQLite file under SAM_OUTPUT_HOME/state/sam-harness.sqlite (node:sqlite).
# SAM_DATABASE_PATH=:memory: for tests, or absolute path to override.
SAM_DATABASE_PATH=
# Optional Postgres — when set, migrations run on Postgres and a local SQLite
# cache keeps sync repository APIs working for the Control Plane.
# DATABASE_URL=postgres://user:pass@localhost:5432/sam_harness
DATABASE_URL=

# —— Multi-tenancy groundwork ——
# Default tenant id for single-owner local use. Switch via Control Plane → Runs.
SAM_TENANT_ID=local

# —— Observability ——
LOG_LEVEL=info
# OpenTelemetry — optional. When unset, tracing is a no-op (in-process spans only).
# OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=sam-harness
OTEL_ENABLED=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sam-harness

# —— Cost cap (Phase 1 + Phase 5) ——
# Daily cloud budget is stored per-tenant (default $0.50).
# $0 forbids all cloud calls. Raise via Control Plane → Hybrid tab.
# Near-cap degradation: see SAM_COST_NEAR_CAP_RATIO above.
# Docs: docs/PHASE5_NEAR_ZERO_COST.md

# —— Phase 6 — verifiable gates & trust ——
# Docs: docs/PHASE6_GATES_TRUST.md
# Master toggles (defaults are production-safe / ON)
SAM_TRUST_GATES=1
SAM_TRUST_AUDIT=1
SAM_TRUST_EVIDENCE=1
# HITL for destructive FS outside SAM_OUTPUT_HOME / cwd
SAM_TRUST_REQUIRE_DESTRUCTIVE_APPROVAL=1
# HITL for outbound email (still also needs APPROVE_COMMS=1)
SAM_TRUST_REQUIRE_EMAIL_APPROVAL=1
# Single cloud charge above this USD requires APPROVE_SPEND=1 (cap still enforced)
SAM_TRUST_SPEND_APPROVAL_USD=0.25
# Comma-separated sensitive desktop app hints (Outlook, banks, password managers, …)
SAM_TRUST_SENSITIVE_APPS=
# Gate retries before escalate (never silent success). Retries = this value; attempts = retries+1
SAM_TRUST_GATE_RETRIES=2
SAM_TRUST_ESCALATE_ON_GATE_FAIL=1
# Auto-approve env flags (CI / trusted local only — never set in untrusted shells)
# APPROVE_TRUST=1
# APPROVE_DESTRUCTIVE=1
# APPROVE_SPEND=1
# APPROVE_COMMS=1
# APPROVE_DESKTOP=1
# Optional policy file: trust-policy.json (see docs/PHASE6_GATES_TRUST.md)

# —— Desktop operator (Phase 4) ——
# APPROVE_DESKTOP=1 auto-approves destructive/financial/sending desktop actions
# (otherwise require approved:true / Control Plane /api/desktop/approvals).
APPROVE_DESKTOP=
# SAM_DESKTOP_DRY_RUN=1 plans actions without side effects
SAM_DESKTOP_DRY_RUN=
# Pause / kill switch (also ~/.sam-harness-desktop-kill or SAM_DESKTOP_KILL_FILE)
SAM_DESKTOP_PAUSED=
SAM_DESKTOP_KILLED=
SAM_DESKTOP_KILL_FILE=
# SAM_DESKTOP_BACKEND=mock forces the in-memory backend (tests)
SAM_DESKTOP_BACKEND=
# SAM_DESKTOP_HOTKEY_WATCHER=1 starts a Windows Ctrl+Shift+Alt+K watcher (optional)
SAM_DESKTOP_HOTKEY_WATCHER=
# SAM_DESKTOP_RECORD_SHOTS=0 disables automatic before/after screenshots
SAM_DESKTOP_RECORD_SHOTS=
