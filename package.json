{
  "name": "Sam-Harness",
  "version": "1.0.0",
  "description": "Hybrid AI agency — Control Plane, LangGraph review, Windows desktop operator",
  "main": "index.js",
  "scripts": {
    "ensure-task": "tsx scripts/ensure-task.ts",
    "typecheck": "tsx scripts/ensure-task.ts && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:desktop": "vitest run tests/desktop-operator.test.ts",
    "test:desktop:windows": "vitest run tests/desktop-windows.integration.test.ts",
    "smoke": "tsx scripts/ensure-task.ts && tsx scripts/smoke-agency.ts && tsx scripts/smoke-delivery.ts && tsx scripts/smoke-capabilities.ts && tsx scripts/smoke-ops-planner.ts && tsx scripts/smoke-controlplane.ts && tsx scripts/smoke-mcp.ts && tsx scripts/smoke-sandbox.ts && tsx scripts/smoke-desktop.ts",
    "smoke:desktop": "tsx scripts/smoke-desktop.ts",
    "start": "tsx index.ts",
    "agency": "tsx index.ts --yes",
    "ui": "tsx src/controlplane/server.ts",
    "control": "tsx src/controlplane/server.ts",
    "smoke:agency": "tsx scripts/smoke-agency.ts",
    "smoke:delivery": "tsx scripts/smoke-delivery.ts",
    "smoke:capabilities": "tsx scripts/smoke-capabilities.ts",
    "smoke:ui": "tsx scripts/smoke-controlplane.ts",
    "smoke:ops": "tsx scripts/smoke-ops-planner.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "smoke:sandbox": "tsx scripts/smoke-sandbox.ts",
    "eval:task-spec": "tsx scripts/eval-task-spec.ts",
    "eval:goal-fidelity": "tsx scripts/eval-goal-fidelity.ts",
    "eval:evidence-scout": "tsx scripts/eval-evidence-scout.ts",
    "eval:pack-home": "tsx scripts/eval-pack-home.ts",
    "smoke:prod-gates": "tsx scripts/smoke-prod-gates.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "dependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/langgraph-checkpoint": "^1.2.1",
    "@langchain/ollama": "^1.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "dotenv": "^18.0.9",
    "nodemailer": "^10.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
