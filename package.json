{
  "name": "Sam-Harness",
  "version": "1.0.0",
  "description": "Hybrid AI agency — Control Plane, LangGraph review, Windows desktop operator",
  "main": "index.js",
  "scripts": {
    "ensure-task": "tsx scripts/ensure-task.ts",
    "typecheck": "tsx scripts/ensure-task.ts && tsc --noEmit",
    "test": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs",
    "test:desktop": "vitest run tests/desktop-operator.test.ts",
    "test:desktop:windows": "vitest run --config vitest.desktop-windows.config.ts",
    "smoke": "tsx scripts/ensure-task.ts && tsx scripts/smoke-agency.ts && tsx scripts/smoke-delivery.ts && tsx scripts/smoke-capabilities.ts && tsx scripts/smoke-ops-planner.ts && tsx scripts/smoke-controlplane.ts && tsx scripts/smoke-mcp.ts && tsx scripts/smoke-sandbox.ts && tsx scripts/smoke-desktop.ts",
    "smoke:desktop": "tsx scripts/smoke-desktop.ts",
    "start": "tsx index.ts",
    "agency": "tsx index.ts --yes",
    "ui": "tsx src/controlplane/server.ts",
    "control": "tsx src/controlplane/server.ts",
    "smoke:agency": "tsx scripts/smoke-agency.ts",
    "smoke:delivery": "tsx scripts/smoke-delivery.ts",
    "smoke:capabilities": "tsx scripts/smoke-capabilities.ts",
    "smoke:ui": "tsx scripts/smoke-controlplane.ts",
    "smoke:ops": "tsx scripts/smoke-ops-planner.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "smoke:sandbox": "tsx scripts/smoke-sandbox.ts",
    "eval:task-spec": "tsx scripts/eval-task-spec.ts",
    "eval:goal-fidelity": "tsx scripts/eval-goal-fidelity.ts",
    "eval:evidence-scout": "tsx scripts/eval-evidence-scout.ts",
    "eval:pack-home": "tsx scripts/eval-pack-home.ts",
    "smoke:prod-gates": "tsx scripts/smoke-prod-gates.ts",
    "trust": "tsx scripts/trust-cli.ts",
    "trust:verify": "tsx scripts/trust-cli.ts verify",
    "trust:approvals": "tsx scripts/trust-cli.ts approvals",
    "trust:approve": "tsx scripts/trust-cli.ts approve",
    "trust:deny": "tsx scripts/trust-cli.ts deny",
    "trust:evidence": "tsx scripts/trust-cli.ts evidence",
    "trust:policy": "tsx scripts/trust-cli.ts policy",
    "doctor": "tsx scripts/doctor.ts",
    "memory": "tsx scripts/memory-cli.ts",
    "migrate": "tsx scripts/migrate.ts",
    "quick:smoke": "tsx scripts/quick-smoke.ts",
    "help": "tsx scripts/help.ts",
    "help:export": "tsx scripts/help-export.ts",
    "tools": "bash Tools/sam-harness-manager.sh",
    "tools:win": "powershell -NoProfile -ExecutionPolicy Bypass -File Tools/Sam-Harness-Manager.ps1",
    "test:tools": "vitest run tests/tools-manager.test.ts",
    "install:unix": "bash scripts/install/install.sh --non-interactive",
    "install:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install/install.ps1 -NonInteractive",
    "uninstall:unix": "bash scripts/install/uninstall.sh --non-interactive",
    "uninstall:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install/uninstall.ps1 -NonInteractive"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "dependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/langgraph-checkpoint": "^1.2.1",
    "@langchain/ollama": "^1.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "dotenv": "^18.0.9",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.3.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
